# Copy to .env and fill in. Use a DEDICATED account (not a superuser) with read
# access to systems + system_stats — the container re-auths every run so the token
# never expires.

# Production: pull a pre-built image from your registry instead of building.
# Build/push it with build-and-push.sh, then set this on the prod host:
# DUCK_IMAGE=registry.example.com/you/beszel-duck:v1

# Hub URL. Internal docker DNS (recommended if sharing the hub network):
#   BESZEL_URL=http://beszel:8090
# or the public URL:
BESZEL_URL=https://kl-beszel.jumbo98.com

BESZEL_EMAIL=duck-ingest@example.com
BESZEL_PASSWORD=change-me
# Auth collection: 'users' (regular account, default) or '_superusers' (admin).
# BESZEL_AUTH_COLLECTION=users

# What to ingest and how often.
GLOB=*
INGEST_INTERVAL=2700    # seconds between runs (45 min). Keep < 3600 (1m retention).
LOOKBACK_MIN=70         # minutes fetched each run; must be >= INGEST_INTERVAL/60.
TZ_OFFSET=8             # peak-time display offset for duck-report (UTC+8)

# Scheduler: 'loop' (default, internal timer) or 'cron' (container idles; you drive
# timing from the docker host crontab — see README "Scheduling").
# INGEST_MODE=loop
