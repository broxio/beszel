# beszel API credentials for the *-api.sh scripts (ad-hoc / troubleshooting).
#
# Copy to ~/.config/beszel/env (the default the scripts look for) and chmod 600:
#   mkdir -p ~/.config/beszel && cp beszel.env.example ~/.config/beszel/env
#   chmod 600 ~/.config/beszel/env
# Then just run e.g.  ./capacity-api.sh 1 'ha-bop*'  with no env juggling.
#
# Override the location with BESZEL_ENV_FILE=/path/to/file if you prefer.
# Explicit env vars always win over this file.

BESZEL_URL=https://kl-beszel.jumbo98.com
BESZEL_EMAIL=duckdb-ingest@eth2.com
BESZEL_PASSWORD=change-me
BESZEL_AUTH_COLLECTION=users      # 'users' (regular account) or '_superusers' (admin)

# The scripts cache the auth token under ~/.cache/beszel and reuse it until ~5 min
# before expiry, so repeated queries don't re-login. Disable with BESZEL_NO_CACHE=1.
